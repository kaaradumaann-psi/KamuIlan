{
  "name": "kamuradar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "KamuRadar — Türkiye'deki kamu personel alım ilanlarını resmî kaynaklardan toplayan, doğrulayan, tekilleştiren ve e-posta ile bildiren platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev-all.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:smtp": "tsx scripts/dev-smtp-server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test e2e/critical.spec.ts --project=chromium",
    "test:live": "tsx scripts/live-check.ts",
    "start": "tsx src/server/main.ts",
    "start:worker": "tsx src/worker/main.ts",
    "env:check": "tsx scripts/check-env.ts",
    "db:indexes": "tsx scripts/create-indexes.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "sources:report": "tsx scripts/coverage-report.ts",
    "fixtures:capture": "tsx scripts/capture-fixtures.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "fixtures:pdf": "tsx scripts/make-pdf-fixtures.ts",
    "seed:admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@tanstack/react-query": "^5.104.2",
    "bullmq": "^6.3.13",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.0",
    "openapi-types": "^12.1.3",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "undici": "^8.11.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.13",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "smtp-server": "^3.19.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
