# ---------------------------------------------------------------------------
# KamuRadar — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Gerçek sırları repoya YAZMAYIN. Üretimde sır yöneticisi kullanın.
# Tüm değişkenler src/config/env.ts içinde doğrulanır: npm run env:check
# ---------------------------------------------------------------------------

# --- Uygulama ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_DISPLAY_NAME=KamuRadar
# Tarayıcıdan görünen temel adres (e-posta bağlantıları bu adresten üretilir).
APP_BASE_URL=http://localhost:5173
# Üretimde ZORUNLU: en az 32 karakter rastgele değer (oturum imzası + jetonlar).
APP_SECRET=
LOG_LEVEL=info

# --- Depolama ---
DATA_DIR=./data
# file: yerel JSON deposu (geliştirme) | mongo: kalıcı MongoDB (üretim)
DATABASE_DRIVER=file
MONGODB_URI=
MONGODB_DB=kamuradar
# Boş bırakılırsa kalıcı yerleşik kuyruk (veritabanı) kullanılır.
REDIS_URL=

# --- Zamanlayıcı / worker ---
SCHEDULER_ENABLED=1
SCHEDULER_TICK_MS=30000
WORKER_NAMESPACE=kamuradar
WORKER_CONCURRENCY=2

# --- Tarama (kaynaklar) ---
SCRAPE_TIMEOUT_MS=60000
SCRAPE_MAX_RETRIES=3
SCRAPE_USER_AGENT=KamuRadarBot/0.1 (+https://github.com/kaaradumaann-psi/kamuradar; kamu personel ilanı toplayıcı)
# Gerçek kaynaklara canlı istek atılsın mı? 0 = ağa çıkılmaz (demo/test).
SOURCE_LIVE_FETCH=1
# Kaynak başına en kısa istek aralığı (ms) — hız sınırlarına saygı için.
SOURCE_MIN_REQUEST_INTERVAL_MS=1500
# SSRF koruması: yalnızca bu alan adlarına istek atılır.
SOURCE_ALLOWED_HOSTS=resmigazete.gov.tr,www.resmigazete.gov.tr,ilan.gov.tr,www.ilan.gov.tr,medya.ilan.gov.tr,osym.gov.tr,www.osym.gov.tr,dokuman.osym.gov.tr,iskur.gov.tr,www.iskur.gov.tr,esube.iskur.gov.tr,kariyerkapisi.gov.tr,www.kariyerkapisi.gov.tr,personel.meb.gov.tr,kamuilan.sbb.gov.tr
# Belge indirme sınırları (bayt / yönlendirme / zaman aşımı)
MAX_DOCUMENT_BYTES=15728640
MAX_REDIRECTS=3
DOCUMENT_TIMEOUT_MS=20000

# --- E-posta (SMTP) ---
# Boş bırakılırsa geliştirmede dosya taşıyıcısı kullanılır ve GERÇEK e-posta
# gönderilmez (data/mail-outbox/*.eml). Üretimde SMTP_HOST zorunludur.
SMTP_HOST=
# Geliştirme posta sunucusu 1025'i dinler; üretimde genelde 587 (STARTTLS).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=KamuRadar <bildirim@example.com>
# Doğrulama/abonelik jetonlarının imzası; boşsa APP_SECRET kullanılır.
EMAIL_VERIFICATION_SECRET=
# Geliştirme dosya taşıyıcısı: 1 → e-postalar diske yazılır (test taşıyıcı).
EMAIL_DEV_FILE_TRANSPORT=1
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=60000
# Geliştirme posta görüntüleyicisi (scripts/dev-smtp-server.ts): http://localhost:1080
DEV_MAIL_VIEWER_PORT=1080

# --- Güvenlik ---
SESSION_TTL_HOURS=336
CSRF_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- İlk yönetici (yalnızca `npm run seed:admin` kullanır; repoda tutulmaz) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
