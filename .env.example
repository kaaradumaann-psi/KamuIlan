# ══════════════════════════════════════════════════════════════════════════════════════════════
#  Kamuİlan — ortam ayarları
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
#  NASIL KULLANILIR
#    1. Kopyalayın:      cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#    2. Yerel geliştirme için HİÇBİR ŞEYİ değiştirmeniz gerekmez:   npm run dev
#    3. Üretim / sağlayıcı ayarları için soru-cevap sihirbazı:      npm run env:setup
#    4. Denetleyin (eksik ya da hatalı ayarı Türkçe açıklar):       npm run env:check
#
#  OKUMA KILAVUZU
#    ★ ÜRETİMDE ZORUNLU   canlıya çıkarken doldurulmalı (yerelde boş kalabilir)
#    ◆ GİZLİ             parola/anahtar: yalnız .env'e yazın, kimseyle paylaşmayın
#    Boş bırakılan satır "Varsayılan" değerini kullanır.
#
#  ÜRETİM İÇİN EN AZ BUNLAR  (ayrıntı: docs/deployment.md)
#    NODE_ENV                    production
#    APP_SECRET                  en az 32 karakter rastgele (npm run env:setup üretir)
#    APP_BASE_URL                sitenin tam adresi, ör. https://kamuilan.ornek.com.tr
#    DATABASE_DRIVER             supabase  +  POSTGRES_URL (Supabase bağlantı dizesi)
#    EMAIL_PROVIDER              resend + RESEND_API_KEY   ya da   smtp + SMTP_HOST
#    EMAIL_FROM                  doğrulanmış alan adından gönderici
#    EMAIL_VERIFICATION_SECRET   en az 32 karakter rastgele
#
#  Bu dosya src/config/env-spec.ts'ten üretilir; elle düzenlemeyin:  npm run env:example
# ══════════════════════════════════════════════════════════════════════════════════════════════


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 1. GENEL                                                                                   │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ Çalışma ortamı
#     development: yerel geliştirme. production: canlı (güvenlik denetimleri sertleşir). test:
#     yalnızca testler.
#     Seçenekler: development | production | test · Varsayılan: development
NODE_ENV=development

# ▸ Uygulama adı
#     Arayüzde ve e-postalarda görünen ad.
#     Varsayılan: Kamuİlan
APP_DISPLAY_NAME=

# ▸ Uygulamanın herkese açık adresi   [★ ÜRETİMDE ZORUNLU]
#     E-posta/Telegram bağlantıları bu adresten üretilir. Sondaki / olmadan yazın.
#     Varsayılan: https://kamuilan.halilkaraduman.com.tr · Örnek: https://kamuilan.example.com
APP_BASE_URL=http://localhost:5173

# ▸ Uygulama alan adı
#     Çerez alan adı ve e-posta gönderen alan adı.
#     Varsayılan: kamuilan.halilkaraduman.com.tr · Örnek: kamuilan.example.com
APP_DOMAIN=

# ▸ API portu
#     Vite geliştirme sunucusu /api isteklerini bu porta iletir.
#     Varsayılan: 3000
PORT=

# ▸ Dinlenecek arayüz adresi
#     0.0.0.0 tüm arayüzler (önizleme/konteyner için gerekir); 127.0.0.1 yalnızca yerel.
#     Varsayılan: 0.0.0.0
HOST=

# ▸ Günlük düzeyi
#     Sorun çözerken debug; üretimde info.
#     Seçenekler: fatal | error | warn | info | debug | trace | silent · Varsayılan: info
LOG_LEVEL=

# ▸ Kalıcı log dosyası
#     Boş: loglar yalnız standart çıktıya gider (systemd/Docker toplar). Dolu: aynı JSON
#     satırları bu dosyaya da yazılır ve boyuta göre döndürülür. API ve worker için AYRI dosya
#     verin (ör. ./logs/api.log, ./logs/worker.log). Sırlar ve e-posta adresleri maskelenir.
#     Durum raporu (npm run durum) son hataları buradan okur.
#     Örnek: ./logs/api.log
LOG_FILE=

# ▸ Log dosyası en büyük boyut (MB)
#     Bu boyutu aşınca dosya .1 olarak döndürülür. Toplam disk ≈ boyut × (saklanan dosya + 1).
#     Varsayılan: 20
LOG_FILE_MAX_MB=

# ▸ Saklanan eski log dosyası sayısı
#     En eskisi silinir. Varsayılan 5 × 20 MB ≈ 120 MB üst sınır.
#     Varsayılan: 5
LOG_FILE_MAX_FILES=

# ▸ Veri dizini
#     Dosya deposu, geliştirme posta kutusu ve raporlar buraya yazılır.
#     Varsayılan: ./data
DATA_DIR=


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 2. GÜVENLİK                                                                                │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ Uygulama sırrı (oturum/jeton imzası)   [★ ÜRETİMDE ZORUNLU · ◆ GİZLİ]
#     En az 32 karakter rastgele metin. Üretimde zorunludur. Örnek üretim: node -e
#     "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# ▸ X-Forwarded-For başlığına hangi vekillerden güvenilsin?
#     0 = hiçbirinden. Önerilen: güvenilen vekil listesi (ör. cloudflare veya
#     10.0.0.0/8,uniquelocal); başlık yalnızca bu adreslerden gelince değerlendirilir. 1 = her
#     kaynaktan (yalnızca API vekil dışından erişilemiyorsa). Yanlış ayar hız sınırını atlatır.
#     Varsayılan: 0
TRUST_PROXY=

# ▸ İzin verilen arayüz kaynakları (virgülle)
#     Geliştirmede Vite adresi. Boş bırakılırsa varsayılan liste kullanılır.
#     Örnek: http://localhost:5173,https://kamuilan.example.com
CORS_ORIGINS=

# ▸ OpenAPI dokümanı (/api/docs) açık mı?
#     Üretimde kapalı olmalıdır; API yüzeyini dışarıya gösterir.
#     Varsayılan: 0
DOCS_ENABLED=

# ▸ CSRF koruması
#     Kapatmak yalnızca özel bir entegrasyon gerekiyorsa değerlendirilir.
#     Varsayılan: 1
CSRF_ENABLED=

# ▸ Oturum ömrü (saat)
#     Kullanıcı oturumunun geçerlilik süresi.
#     Varsayılan: 336
SESSION_TTL_HOURS=

# ▸ Hız sınırı penceresi (saniye)
#     Genel API hız sınırı penceresi.
#     Varsayılan: 60
RATE_LIMIT_WINDOW_SECONDS=

# ▸ Hız sınırı istek hakkı
#     Pencere başına izin verilen istek sayısı.
#     Varsayılan: 120
RATE_LIMIT_MAX_REQUESTS=

# ▸ Giriş denemesi sınırı
#     Oturum açma uçları için daha sıkı sınır (brute-force koruması).
#     Varsayılan: 10
AUTH_RATE_LIMIT_MAX_REQUESTS=

# ▸ Herkese açık kayıt
#     Kamuİlan politikası: hesaplar yönetici davetiyle açılır; bu ayar kapalı (0) kalmalıdır.
#     Varsayılan: 0
ALLOW_PUBLIC_REGISTRATION=

# ▸ Herkese açık ilan vitrini
#     Açıkken (1) oturumsuz ziyaretçi ilan listesi, detayı ve kaynakları görür; panel ve yönetim
#     yine giriş ister. Ürün + KVKK kararıdır; varsayılan 0.
#     Varsayılan: 0
PUBLIC_LISTINGS_ENABLED=

# ▸ TLS doğrulamasını kapatma anahtarı (KALDIRILMALI)
#     Node'un acil durum anahtarıdır: 0 yazıldığında HTTPS ve Postgres dahil TÜM TLS
#     bağlantılarında sertifika denetimi ATLANIR. Bu proje bunu bir çözüm olarak kabul etmez;
#     doğru karşılık eksik kökü/zinciri tamamlamaktır: POSTGRES_SSL_CA_FILE (Supabase CA),
#     POSTGRES_SSL_CA_MERGE_SYSTEM=1 (dosya + sistem kökleri), NODE_EXTRA_CA_CERTS (kurum kökü),
#     Node 22.15+ (sistem kök deposu) ve npm run db:tls-doctor (kök nedeni otomatik bulur). Bu
#     alanı BOŞALTMAK (:clear) anahtarı .env dosyasından kaldırır; kabukta/kullanıcı
#     değişkenlerinde tanımlıysa ayrıca silinmelidir (Windows: setx NODE_TLS_REJECT_UNAUTHORIZED
#     "").
#     Bu anahtar için atama satırı bilerek YOK: yazmayın.


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 3. VERİTABANI (SUPABASE/POSTGRES)                                                          │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ Depo sürücüsü
#     supabase/postgres: üretim. file: yerel geliştirme (tek JSON dosyası). mongo: eski
#     kurulumlar.
#     Seçenekler: supabase | postgres | file | mongo
DATABASE_DRIVER=file

# ▸ Supabase/Postgres bağlantı dizesi   [◆ GİZLİ]
#     Supabase → Project Settings → Database → Connection string. TLS parametresi (sslmode,
#     sslrootcert) YAZMAYIN; bu uygulama TLS kararını POSTGRES_SSL_MODE ile verir.
#     Şu durumda gerekmez: DATABASE_DRIVER=postgres/supabase seçilmedi.
POSTGRES_URL=

# ▸ Alternatif bağlantı dizesi (DATABASE_URL)   [◆ GİZLİ]
#     Bazı sağlayıcılar bu adı verir. POSTGRES_URL doluysa boş bırakın.
#     Şu durumda gerekmez: POSTGRES_URL tanımlı.
DATABASE_URL=

# ▸ Veritabanı TLS kullanılsın mı?
#     Supabase TLS ister (true). false yalnızca yerel/güvenili ağ Postgres'inde; üretimde
#     env:check engeller.
#     Varsayılan: 1
#     Şu durumda gerekmez: Postgres seçilmedi.
POSTGRES_SSL=

# ▸ TLS doğrulama kipi
#     verify: sertifika doğrulanır (varsayılan ve önerilen). no-verify/disable: doğrulama kapalı
#     — MITM riski; üretimde engellenir. Doğrulamayı kapatmayın.
#     Seçenekler: (boş) | verify | no-verify | disable
#     Şu durumda gerekmez: Postgres seçilmedi.
POSTGRES_SSL_MODE=

# ▸ CA sertifika dosyası yolu (PEM)
#     SELF_SIGNED_CERT_IN_CHAIN alıyorsanız Supabase → Database Settings → SSL Configuration
#     bölümünden indirdiğiniz CA dosyası. Örnek: ./certs/supabase-ca.crt — boş bırakırsanız
#     sistem kökleri kullanılır. Tanılama: npm run db:tls-doctor
#     Örnek: ./certs/supabase-ca.crt
#     Şu durumda gerekmez: Postgres seçilmedi.
POSTGRES_SSL_CA_FILE=

# ▸ CA dosyası sistem kökleriyle birleştirilsin mi?
#     1: dosya kökleri + Node/Windows kökleri + NODE_EXTRA_CA_CERTS birlikte kullanılır
#     (doğrulama açık kalır). Doğrudan bağlantı ile pooler farklı kök sunuyorsa ya da kurumsal
#     TLS denetimi varsa gerekir.
#     Varsayılan: 0
#     Şu durumda gerekmez: POSTGRES_SSL_CA_FILE tanımlı değil (zaten sistem kökleri
#     kullanılıyor).
POSTGRES_SSL_CA_MERGE_SYSTEM=

# ▸ Ek kök sertifika dosyası (NODE_EXTRA_CA_CERTS)
#     Kurumsal proxy/antivirüs TLS denetimi ya da eksik zincir sunan resmî siteler için.
#     YALNIZCA yöneticinizden/doğrulayabildiğiniz kaynaktan aldığınız kökleri içeren PEM
#     dosyası. Node bu dosyayı süreç BAŞLARKEN okur; bu yüzden süreç çalışırken değiştirilirse
#     yeniden başlatın. Dosya bulunamazsa Node SESSİZCE yok sayar (uygulama çökmez ama kök de
#     yüklenmez) — sihirbaz bu tuzağı engellemek için yolun var olduğunu doğrular. Örnek:
#     C:/certs/kurum-ca.pem
#     Örnek: C:/certs/kurum-ca.pem
# NODE_EXTRA_CA_CERTS=

# ▸ En çok bağlantı (havuz boyutu)
#     Supabase ücretsiz katmanda küçük tutun (5-10). API + worker ayrı havuz açar.
#     Varsayılan: 10
#     Şu durumda gerekmez: Postgres seçilmedi.
POSTGRES_MAX_CONNECTIONS=

# ▸ Supabase proje adresi
#     Supabase → Project Settings → API. Uygulama şu an veritabanı için POSTGRES_URL kullanır;
#     bu alan panelden bilgi almak içindir.
#     Örnek: https://<proje>.supabase.co
SUPABASE_URL=

# ▸ Supabase anon anahtarı   [◆ GİZLİ]
#     Herkese açık anahtar. Kullanılmıyorsa boş bırakın.
SUPABASE_ANON_KEY=

# ▸ Supabase service role anahtarı   [◆ GİZLİ]
#     YALNIZCA sunucu tarafı; tarayıcıya asla verilmez, repoya yazılmaz.
SUPABASE_SERVICE_ROLE_KEY=

# ▸ MongoDB bağlantı dizesi (eski kurulumlar)   [◆ GİZLİ]
#     Yalnızca DATABASE_DRIVER=mongo ise gerekir.
#     Şu durumda gerekmez: DATABASE_DRIVER=mongo seçilmedi.
MONGODB_URI=

# ▸ MongoDB veritabanı adı
#     Yalnızca MongoDB sürücüsü kullanılıyorsa.
#     Varsayılan: kamuilan
#     Şu durumda gerekmez: DATABASE_DRIVER=mongo seçilmedi.
MONGODB_DB=

# ▸ Redis adresi (BullMQ)   [◆ GİZLİ]
#     Boş bırakılırsa yerleşik (Postgres/dosya tabanlı) kuyruk kullanılır.
REDIS_URL=


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 4. KUYRUK VE ZAMANLAYICI                                                                   │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ Zamanlanmış tarama açık mı?
#     Worker sürecinde planlı taramaları çalıştırır. Varsayılan KAPALIDIR: start:worker tek
#     başına tüm kaynakları taramaya başlamaz. Üretimde bilinçli olarak 1 yapın.
#     Varsayılan: 0
SCHEDULER_ENABLED=0

# ▸ Zamanlayıcı adımı (ms)
#     Planlayıcının ne sıklıkta uyandığı.
#     Varsayılan: 30000
SCHEDULER_TICK_MS=

# ▸ Genel tarama aralığı (dakika)
#     0 (önerilen): her kaynak kendi aralığıyla taranır. Pozitif değer tüm kaynakları eşitler;
#     en küçük 15 dakikadır.
#     Varsayılan: 0
SCAN_INTERVAL_MINUTES=

# ▸ Worker ad alanı
#     Aynı veritabanını paylaşan farklı kurulumları ayırır.
#     Varsayılan: kamuilan
WORKER_NAMESPACE=

# ▸ Worker eşzamanlılığı
#     Aynı anda işlenen iş sayısı. Küçük makinelerde 1-2.
#     Varsayılan: 2
WORKER_CONCURRENCY=


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 5. KAYNAK TARAMA                                                                           │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ Gerçek kaynaklara istek atılsın mı?
#     Varsayılan 0: worker ağa çıkmaz; tarama "atlandı" kaydedilir, başarı sayılmaz. Gerçek
#     tarama için SOURCE_LIVE_FETCH=1 ve SCHEDULER_ENABLED=1 AYRI AYRI bilinçli açılmalıdır.
#     Varsayılan: 0
SOURCE_LIVE_FETCH=0

# ▸ Kaynak kullanım şartları kapısı
#     enforce (varsayılan, 22.10.2026 kullanıcı kararı): yalnız config/source-terms.json içinde
#     incelenmiş ve "allowed" kaynak taranır (şu an Resmî Gazete + İŞKUR). warn: incelenmemiş
#     kaynak da taranır, tarama notunda görünür. "blocked" kaynak her iki modda da atlanır.
#     Seçenekler: warn | enforce · Varsayılan: enforce
SOURCE_TERMS_POLICY=

# ▸ Eksik sertifika zinciri AIA ile tamamlansın mı?
#     Bazı resmî siteler (ilan.gov.tr, BDDK, TMSF) TLS'te yalnızca yaprak sertifikayı gönderir;
#     Node zinciri tamamlayamadığı için UNABLE_TO_VERIFY_LEAF_SIGNATURE verir. 1: eksik ara
#     sertifika, yapraktaki AIA adresinden indirilir; İMZASI, CA durumu ve süresi doğrulanır,
#     zincir GÜVENİLEN bir köke bağlanıyorsa istek doğrulama AÇIKKEN yeniden denenir. 0:
#     tamamlama yapılmaz. Doğrulamayı kapatmaz; kapatmak için NODE_TLS_REJECT_UNAUTHORIZED=0
#     KULLANILMAZ.
#     Varsayılan: 1
SOURCE_TLS_AIA_COMPLETION=

# ▸ Tarayıcı yedeği (Chromium) kullanılsın mı?
#     HTTP istemcisi cevap alamadığında (ECONNRESET/zaman aşımı) sayfa başsız Chromium ile
#     okunur. 0: tarayıcı hiç başlatılmaz, asıl HTTP hatası bildirilir. Chromium kurulu değilse
#     (npx playwright install chromium) ya da sunucuda tarayıcı istenmiyorsa 0 yazın. Varsayılan
#     0 (güvenli): açıkça 1 yapılmadıkça tarayıcı başlatılmaz. Testlerde zorunlu olarak 0'dır:
#     Chromium gerçek ağa çıktığı için sahte istemciyi yanıltır.
#     Varsayılan: 0
SOURCE_BROWSER_FALLBACK=0

# ▸ Tarama zaman bütçesi (ms)
#     Tek kaynak taramasının toplam süresi. Resmî siteler yavaştır; çok düşük değer taramaları
#     başarısız kılar. Süre bitmeye yaklaştığında adaptör yeni detay indirmeyi bırakır ve okunan
#     satırları "kısmi" olarak kaydeder. Önerilen: 120000 (PDF ağırlıklı kaynaklarda 180000).
#     Varsayılan: 120000
SCRAPE_TIMEOUT_MS=

# ▸ En çok yeniden deneme
#     Kaynak hatasında deneme sayısı.
#     Varsayılan: 3
SCRAPE_MAX_RETRIES=

# ▸ Tarayıcı kimliği (User-Agent)
#     Uygulama kendini gizlemez: adı, sürümü ve iletişim adresi yazılır; tarayıcı taklidi
#     yapılmaz. "Bot" kelimesi kullanılmaz (Resmî Gazete bu istemcileri askıda bırakıyor; K2
#     kararı 22.10.2026). Değiştirmeniz gerekmez.
#     Varsayılan: kaynak tanımlarından (boş bırakın)
SCRAPE_USER_AGENT=

# ▸ Kaynak başına en az istek aralığı (ms)
#     Resmî siteleri yıpratmamak için alt sınır.
#     Varsayılan: 1500
SOURCE_MIN_REQUEST_INTERVAL_MS=

# ▸ Ek izinli ana makineler (virgülle)
#     Kaynak envanterindeki alan adlarına ek olarak izin verilecekler.
#     Varsayılan: kaynak tanımlarından (boş bırakın)
SOURCE_ALLOWED_HOSTS=

# ▸ En çok belge boyutu (bayt)
#     Büyük PDF/HTML indirmelerini sınırlar.
#     Varsayılan: 15728640
MAX_DOCUMENT_BYTES=

# ▸ En çok yönlendirme
#     Yönlendirme döngülerini keser.
#     Varsayılan: 3
MAX_REDIRECTS=

# ▸ Belge (PDF) zaman aşımı (ms)
#     PDF indirme/çözümleme süresi.
#     Varsayılan: 20000
DOCUMENT_TIMEOUT_MS=

# ▸ Taranmış PDF için OCR
#     Metin katmanı olmayan PDF ilanlar tesseract.js (Türkçe) ile okunur. Sayfa başına birkaç
#     saniye CPU. Güveni düşük metin kullanılmaz.
#     Varsayılan: 0
OCR_ENABLED=

# ▸ OCR Türkçe dil verisi yolu
#     tur.traineddata(.gz) dosyasının bulunduğu yerel dizin. Boşsa tesseract.js dil verisini
#     kendi dağıtımından bir kez indirip önbelleğe alır.
#     Şu durumda gerekmez: OCR_ENABLED kapalı.
OCR_LANG_PATH=

# ▸ OCR asgari güven (0–100)
#     Ortalama güveni bunun altındaki OCR metni kullanılmaz; kayıt incelemeye gider.
#     Varsayılan: 70
#     Şu durumda gerekmez: OCR_ENABLED kapalı.
OCR_MIN_CONFIDENCE=

# ▸ Belge başına OCR sayfası
#     Taranmış belgenin ilk kaç sayfası okunur.
#     Varsayılan: 4
#     Şu durumda gerekmez: OCR_ENABLED kapalı.
OCR_MAX_PAGES=

# ▸ Koşu başına OCR belgesi
#     Tek taramada OCR yapılacak azami belge; kalanlar sonraki taramaya kalır.
#     Varsayılan: 3
#     Şu durumda gerekmez: OCR_ENABLED kapalı.
OCR_MAX_DOCS_PER_RUN=

# ▸ Resmî Gazete geriye dönük tarama (gün)
#     0 = kapalı. Örn. 60: worker son 60 günün Çeşitli İlânlar bölümlerini bir kez, kalıcı
#     ilerleme kaydıyla koşum başına birkaç gün tarar; bitince durur. Süresi geçmiş ilanlar
#     "kapandı" olarak arşivlenir.
#     Varsayılan: 0
RG_BACKFILL_DAYS=

# ▸ Geri taramada koşum başına gün
#     Bir Resmî Gazete koşumunda işlenecek azami geçmiş gün; PDF bütçesi günlük taramayla
#     ortaktır.
#     Varsayılan: 3
#     Şu durumda gerekmez: RG_BACKFILL_DAYS kapalı.
RG_BACKFILL_DAYS_PER_RUN=


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 6. E-POSTA                                                                                 │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ E-posta sağlayıcısı
#     resend: üretim. smtp: kendi sunucunuz. file: geliştirme (e-posta data/mail içine yazılır,
#     GERÇEK gönderim olmaz).
#     Seçenekler: resend | smtp | file · Varsayılan: smtp
EMAIL_PROVIDER=smtp

# ▸ Resend API anahtarı   [★ ÜRETİMDE ZORUNLU · ◆ GİZLİ]
#     Resend → API Keys. Üretimde EMAIL_PROVIDER=resend ise zorunludur.
#     Şu durumda gerekmez: EMAIL_PROVIDER=resend değil.
RESEND_API_KEY=

# ▸ Resend API adresi
#     Yalnızca özel bir vekil kullanıyorsanız değiştirin.
#     Varsayılan: https://api.resend.com
#     Şu durumda gerekmez: EMAIL_PROVIDER=resend değil.
RESEND_API_BASE_URL=

# ▸ SMTP sunucu adresi   [★ ÜRETİMDE ZORUNLU]
#     EMAIL_PROVIDER=smtp ise zorunludur. Boş bırakırsanız geliştirmede yerel posta sunucusu
#     kullanılır.
#     Örnek: smtp.example.com
#     Şu durumda gerekmez: EMAIL_PROVIDER=smtp değil.
SMTP_HOST=127.0.0.1

# ▸ SMTP portu
#     587 (STARTTLS) ya da 465 (TLS). Yerel geliştirme sunucusu 1025.
#     Varsayılan: 1025
#     Şu durumda gerekmez: EMAIL_PROVIDER=smtp değil.
SMTP_PORT=1025

# ▸ SMTP doğrudan TLS (465)?
#     465 için 1, 587 (STARTTLS) için 0.
#     Varsayılan: 0
#     Şu durumda gerekmez: EMAIL_PROVIDER=smtp değil.
SMTP_SECURE=

# ▸ SMTP sertifika doğrulaması kapatılsın mı? (ÖNERİLMEZ)
#     Varsayılan 0: SMTP sunucusunun sertifikası doğrulanır. 1 yazmak doğrulamayı KAPATIR; TLS
#     kullanılsa bile sunucu kimliği doğrulanmaz ve SMTP_USER/SMTP_PASS ortadaki adama açık
#     kalır. Sertifika hatasının doğru çözümü eksik kökü eklemektir:
#     NODE_EXTRA_CA_CERTS=./certs/kurum-koku.pem (kendinden imzalı geliştirme sunucusu için bile
#     doğrulamayı kapatmayın; kökü dosyaya koyun).
#     Varsayılan: 0
#     Şu durumda gerekmez: EMAIL_PROVIDER=smtp değil.
SMTP_TLS_INSECURE=

# ▸ SMTP kullanıcı adı
#     Sağlayıcının verdiği kullanıcı.
#     Şu durumda gerekmez: EMAIL_PROVIDER=smtp değil.
SMTP_USER=

# ▸ SMTP parolası   [◆ GİZLİ]
#     Üretimde "dev-" ile başlayan geliştirme parolası kullanılamaz.
#     Şu durumda gerekmez: EMAIL_PROVIDER=smtp değil.
SMTP_PASS=

# ▸ Gönderen adresi   [★ ÜRETİMDE ZORUNLU]
#     Doğrulanmış alan adından olmalıdır; aksi halde gönderim reddedilir.
#     Varsayılan: Kamuİlan <bildirim@kamuilan.halilkaraduman.com.tr> · Örnek:
#     bildirim@kamuilan.example.com
#     Şu durumda gerekmez: E-posta sağlayıcısı file (geliştirme).
EMAIL_FROM=

# ▸ E-posta doğrulama sırrı   [★ ÜRETİMDE ZORUNLU · ◆ GİZLİ]
#     Doğrulama bağlantılarının imzası. Üretimde en az 32 karakter.
EMAIL_VERIFICATION_SECRET=

# ▸ Geliştirmede dosyaya yazma
#     1: e-postalar data/mail içine yazılır (gerçek gönderim yok).
#     Varsayılan: 1
EMAIL_DEV_FILE_TRANSPORT=

# ▸ E-posta deneme sayısı
#     Teslim başarısız olursa yeniden deneme üst sınırı.
#     Varsayılan: 5
EMAIL_MAX_ATTEMPTS=

# ▸ Yeniden deneme taban süresi (ms)
#     Artan gecikme (backoff) tabanı.
#     Varsayılan: 60000
EMAIL_RETRY_BASE_MS=

# ▸ Geliştirme posta görüntüleyici portu
#     npm run dev ile açılan yerel posta kutusu arayüzü (http://localhost:1080).
#     Varsayılan: 1080
DEV_MAIL_VIEWER_PORT=


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 7. TELEGRAM                                                                                │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ Telegram bot jetonu   [◆ GİZLİ]
#     BotFather → /token. Boş bırakırsanız Telegram bildirimleri kapalı kalır.
TELEGRAM_BOT_TOKEN=

# ▸ Telegram bot kullanıcı adı
#     Jeton tanımlıysa zorunludur; "bot" ile biter (ör. KamuIlanBildirim_BOT).
#     Örnek: KamuIlanBildirim_BOT
#     Şu durumda gerekmez: TELEGRAM_BOT_TOKEN boş.
TELEGRAM_BOT_USERNAME=

# ▸ Telegram webhook sırrı   [★ ÜRETİMDE ZORUNLU · ◆ GİZLİ]
#     1-256 karakter (A-Z a-z 0-9 _ -). Üretimde jeton tanımlıysa zorunludur.
#     Şu durumda gerekmez: TELEGRAM_BOT_TOKEN boş.
TELEGRAM_WEBHOOK_SECRET=

# ▸ Telegram API adresi
#     Yalnızca vekil kullanıyorsanız değiştirin.
#     Varsayılan: https://api.telegram.org
#     Şu durumda gerekmez: TELEGRAM_BOT_TOKEN boş.
TELEGRAM_API_BASE_URL=


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 8. LLM / YAPAY ZEKÂ                                                                        │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ Kullanıcıya açık yapay zekâ yardımcısı
#     Açmak için LLM_BASE_URL + LLM_API_KEY + LLM_MODEL zorunludur.
#     Varsayılan: 0
AI_ASSISTANT_ENABLED=0

# ▸ LLM sınıflandırma kapısı
#     Kuralların kararsız kaldığı duyurular için ikinci aşama denetimi. Kanıtı doğrulanamayan
#     karar yayımlanmaz.
#     Varsayılan: 0
LLM_CLASSIFIER_ENABLED=0

# ▸ LLM sağlayıcı adresi (OpenAI uyumlu)
#     Üretimde https:// zorunludur (kişisel profil verisi taşınır). Örnek:
#     https://generativelanguage.googleapis.com/v1beta/openai
#     Örnek: https://generativelanguage.googleapis.com/v1beta/openai
#     Şu durumda gerekmez: AI_ASSISTANT_ENABLED ve LLM_CLASSIFIER_ENABLED kapalı.
LLM_BASE_URL=

# ▸ LLM API anahtarı   [◆ GİZLİ]
#     Sağlayıcının anahtarı. Sır değerdir; repoya yazılmaz.
#     Şu durumda gerekmez: AI_ASSISTANT_ENABLED ve LLM_CLASSIFIER_ENABLED kapalı.
LLM_API_KEY=

# ▸ LLM modeli (yardımcı)
#     Örnek: gemini-2.5-flash.
#     Örnek: gemini-2.5-flash
#     Şu durumda gerekmez: AI_ASSISTANT_ENABLED ve LLM_CLASSIFIER_ENABLED kapalı.
LLM_MODEL=

# ▸ LLM modeli (sınıflandırma)
#     Boş bırakılırsa LLM_MODEL kullanılır.
#     Şu durumda gerekmez: LLM_CLASSIFIER_ENABLED kapalı.
LLM_CLASSIFIER_MODEL=

# ▸ Yedek modeller (sınıflandırma)
#     Virgülle ayrılmış, aynı uç noktadaki yedek modeller (ör.
#     qwen/qwen3.8-27b,openai/gpt-oss-120b). Kota/geçici hata/erişilemeyen modelde sıradakine
#     geçilir; anahtar hatasında (401/403) geçilmez.
#     Şu durumda gerekmez: LLM_CLASSIFIER_ENABLED kapalı.
LLM_CLASSIFIER_FALLBACK_MODELS=

# ▸ Akıl yürütme düzeyi (gpt-oss / o-serisi)
#     Yalnız gpt-oss ve o-serisi modellere reasoning_effort olarak gönderilir; diğer modellere
#     gönderilmez. Groq gpt-oss için "low" önerilir: ölçümde çıktı ~800 → ~250 token,
#     şema-geçerli karar. Boş: gönderilmez.
#     Seçenekler: (boş) | low | medium | high
#     Şu durumda gerekmez: LLM_CLASSIFIER_ENABLED kapalı.
LLM_REASONING_EFFORT=

# ▸ Sağlayıcı etiketi
#     Arayüzde gösterilen ad (ör. Gemini).
#     Varsayılan: harici bir yapay zekâ hizmeti
AI_PROVIDER_LABEL=

# ▸ LLM zaman aşımı (ms)
#     Sağlayıcı yanıt süresi üst sınırı.
#     Varsayılan: 30000
LLM_TIMEOUT_MS=

# ▸ Kullanıcı başına günlük yardımcı sınırı
#     Kötüye kullanımı ve maliyeti sınırlar.
#     Varsayılan: 5
AI_DAILY_LIMIT_PER_USER=

# ▸ Sınıflandırmada en çok girdi karakteri
#     Uzun metinler kırpılır; maliyet kontrolü.
#     Varsayılan: 12000
LLM_MAX_INPUT_CHARS=

# ▸ Tarama başına en çok LLM çağrısı
#     Bir tarama koşumunda yapılacak çağrı üst sınırı.
#     Varsayılan: 12
LLM_MAX_CALLS_PER_RUN=

# ▸ Günlük LLM çağrı sınırı
#     Kota/maliyet koruması.
#     Varsayılan: 400
LLM_DAILY_CALL_LIMIT=

# ▸ Eşzamanlı LLM çağrısı
#     Sağlayıcı hız sınırına göre ayarlayın.
#     Varsayılan: 2
LLM_MAX_CONCURRENCY=

# ▸ LLM yeniden deneme sayısı
#     Geçici sağlayıcı hatalarında deneme üst sınırı.
#     Varsayılan: 1
LLM_RETRY_MAX=

# ▸ Girdi maliyeti (USD / milyon token)
#     Boş bırakılırsa maliyet RAPORLANMAZ (uydurulmaz). Sağlayıcı fiyatını doğrulayarak yazın.
LLM_COST_USD_PER_MTOK_INPUT=

# ▸ Çıktı maliyeti (USD / milyon token)
#     Boş bırakılırsa maliyet RAPORLANMAZ (uydurulmaz). Sağlayıcı fiyatını doğrulayarak yazın.
LLM_COST_USD_PER_MTOK_OUTPUT=

# ▸ Tek worker koşusu için tahmini USD tavanı
#     Maliyet rezervasyonu için pozitif limit. Her iki resmi fiyat varsayımı olmadan LLM çağrısı
#     fail-closed kalır; sağlayıcı faturası garantisi değildir.
#     Şu durumda gerekmez: AI/LLM özellikleri kapalı.
LLM_RUN_COST_LIMIT_USD=

# ▸ Tüm worker’lar için 24 saatlik tahmini USD tavanı
#     Atomik ortak maliyet rezervasyonu. Her iki resmi fiyat varsayımı olmadan LLM çağrısı
#     fail-closed kalır; sağlayıcı faturası garantisi değildir.
#     Şu durumda gerekmez: AI/LLM özellikleri kapalı.
LLM_DAILY_COST_LIMIT_USD=


# ┌────────────────────────────────────────────────────────────────────────────────────────────┐
# │ 9. YÖNETİM VE İLK HESAP                                                                    │
# └────────────────────────────────────────────────────────────────────────────────────────────┘

# ▸ İlk yönetici e-postası
#     npm run seed:admin bu değerle ilk yönetici hesabını oluşturur.
#     Örnek: yonetici@example.com
ADMIN_EMAIL=

# ▸ İlk yönetici parolası   [◆ GİZLİ]
#     Uzun ve rastgele seçin. Seed sonrası .env içinden kaldırmanız önerilir.
ADMIN_PASSWORD=
