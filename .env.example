# ---------------------------------------------------------------------------
# KamuRadar — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın. Gerçek sırları repoya yazmayın.
# ---------------------------------------------------------------------------

# Uygulama
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Tarayıcıdan görünen temel adres (e-posta bağlantıları bu adresten üretilir).
APP_BASE_URL=http://localhost:5173
# Üretimde mutlaka değiştirin. En az 32 karakter rastgele değer.
APP_SECRET=
LOG_LEVEL=info
APP_DISPLAY_NAME=KamuRadar

# Veritabanı — boş bırakılırsa yerel dosya deposu (data/kamuradar.json) kullanılır.
# Üretimde kalıcı MongoDB zorunludur.
MONGODB_URI=
MONGODB_DB=kamuradar
DATA_DIR=./data

# Kuyruk — boş bırakılırsa kalıcı yerleşik kuyruk (veritabanı) kullanılır.
REDIS_URL=

# Zamanlayıcı / tarama
SCRAPE_DEFAULT_INTERVAL_MINUTES=60
SCRAPE_CONCURRENCY=2
SCRAPE_TIMEOUT_MS=30000
SCRAPE_MAX_RETRIES=3
SCRAPE_DEADLINE_REFRESH_HOURS=12
COVERAGE_AUDIT_HOURS=24
# Gerçek kaynaklara canlı istek atmadan çalıştırmak için (demo/test): 1
SOURCE_LIVE_FETCH=1
# Canlı doğrulama ve smoke testlerde kullanılan kullanıcı aracısı.
SCRAPER_USER_AGENT=KamuRadarBot/0.1 (+https://github.com/kaaradumaann-psi/kamuradar; kamu personel ilanı toplayıcı)

# E-posta (SMTP). Boş bırakılırsa geliştirme modunda dosya taşıyıcı kullanılır
# ve HİÇBİR gerçek e-posta gönderilmez.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=KamuRadar <bildirim@example.com>
EMAIL_VERIFICATION_SECRET=
# Geliştirme: 1 -> e-postalar data/mail-outbox/*.eml olarak yazılır (test taşıyıcı).
EMAIL_DEV_FILE_TRANSPORT=1
# Test e-posta sunucusu (scripts/dev-smtp-server.ts) dinleme portu
DEV_SMTP_PORT=1025
# Deneme sayısı ve tekrar deneme aralığı
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=60000

# Güvenlik
SESSION_TTL_HOURS=336
CSRF_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Yönetici oluşturma (scripts/create-admin.ts ile kullanılır, repoda tutulmaz)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kaynak adaptörleri
# Yalnızca bu alan adlarına istek atılır (SSRF koruması + yönetici kaynağı ekleme).
SOURCE_ALLOWED_HOSTS=resmigazete.gov.tr,www.resmigazete.gov.tr,ilan.gov.tr,www.ilan.gov.tr,osym.gov.tr,www.osym.gov.tr,kariyerkapisi.gov.tr,www.kariyerkapisi.gov.tr,iskur.gov.tr,www.iskur.gov.tr,personel.meb.gov.tr,dokuman.osym.gov.tr
# Kaynak başına en kısa istek aralığı (ms)
SOURCE_MIN_REQUEST_INTERVAL_MS=1500
# İndirilen belge sınırları
MAX_DOCUMENT_BYTES=15728640
MAX_REDIRECTS=3
