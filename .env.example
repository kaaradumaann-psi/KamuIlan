# ---------------------------------------------------------------------------
# Kamuİlan — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Gerçek sırları repoya YAZMAYIN. Üretimde sır yöneticisi kullanın.
# Tüm değişkenler src/config/env.ts içinde doğrulanır: npm run env:check
# ---------------------------------------------------------------------------

# --- Uygulama ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_DISPLAY_NAME=Kamuİlan
# Tarayıcıdan görünen temel adres (e-posta bağlantıları bu adresten üretilir).
APP_BASE_URL=http://localhost:5173
# Üretim alan adı (Cloudflare): kamuilan.halilkaraduman.com.tr
APP_DOMAIN=kamuilan.halilkaraduman.com.tr
# Üretimde ZORUNLU: en az 32 karakter rastgele değer (oturum imzası + jetonlar).
APP_SECRET=
LOG_LEVEL=info

# --- Depolama ---
DATA_DIR=./data
# file (geliştirme) | postgres (yerel/Docker) | supabase (üretim) | mongo (eski)
DATABASE_DRIVER=file

# PostgreSQL / Supabase. Supabase panosu: Project Settings → Database → Connection
# string. Sunucudan bağlanılır; "Transaction pooler" (port 6543) önerilir.
# Üretimde POSTGRES_URL ZORUNLUDUR (DATABASE_DRIVER=postgres|supabase).
POSTGRES_URL=
# Alternatif ad: DATABASE_URL verilirse POSTGRES_URL yerine kullanılır.
DATABASE_URL=
# Supabase TLS ister; yerel Postgres'te false bırakılabilir (false = TLS hiç kullanılmaz).
POSTGRES_SSL=true
# Veritabanı kök CA sertifikasının PEM dosya yolu. Tanımlanırsa sunucu sertifikası
# YALNIZCA bu CA ile doğrulanır. Okunamazsa doğrulamasıza DÜŞÜRÜLMEZ, bağlantı hatası verilir.
# Supabase uç noktasına göre proje CA'sı gerekebilir: Database Settings → SSL
# Configuration bölümünden indirin. Örnek: ./certs/supabase-ca.crt
# SELF_SIGNED_CERT_IN_CHAIN çözümü: docs/database-tls.md
# Kök nedeni otomatik bulur: npm run db:tls-doctor (parola göndermeden sunucunun
# sunduğu zinciri okur, eksik halkayı ve yapılacak adımı yazar).
POSTGRES_SSL_CA_FILE=
# CA dosyası sistem kökleriyle BİRLEŞTİRİLSİN mi? (0 = yalnızca CA dosyası, pinning)
# 1 yapın: doğrudan bağlantı ile pooler farklı kök sunuyorsa, hem Supabase proje CA'sı
# hem kurumsal TLS denetimi kökü (NODE_EXTRA_CA_CERTS) gerekiyorsa ya da sunucu zinciri
# eksik gönderiliyorsa. Doğrulama AÇIK kalır; yalnızca güven kümesi genişler.
# Bu ayar NODE_TLS_REJECT_UNAUTHORIZED=0 DEĞİLDİR.
POSTGRES_SSL_CA_MERGE_SYSTEM=0
# NODE_TLS_REJECT_UNAUTHORIZED=0 YAZMAYIN: TLS doğrulamasını tüm süreçte kapatır (test/tarama
# sonuçları güvenilmez olur, MITM ayırt edilemez). SELF_SIGNED_CERT_IN_CHAIN / UNABLE_TO_VERIFY_LEAF_SIGNATURE
# için doğru yol yukarıdaki CA dosyası + birleştirme + NODE_EXTRA_CA_CERTS ve `npm run db:tls-doctor`.
# Zaten tanımlıysa kaldırın (Windows: setx NODE_TLS_REJECT_UNAUTHORIZED "" → yeni kabuk açın).
# Kurumsal proxy/antivirüs TLS denetimi varsa (yalnızca yöneticinizden doğruladığınız kök):
# NODE_EXTRA_CA_CERTS=C:/certs/kurum-ca.pem
# TLS doğrulama kipi. Boş = POSTGRES_SSL'e göre (true → verify, false → disable).
#  verify    : sunucu sertifikası doğrulanır (varsayılan; gerekirse proje CA dosyasını verin)
#  no-verify : TLS kullanılır, sertifika doğrulanmaz — AÇIK risk kabulü; üretimde env:check ENGELLESİ
#  disable   : TLS hiç kullanılmaz (yalnızca yerel/güvenili ağ Postgres'i)
# DİKKAT: Bağlantı dizesine (POSTGRES_URL) sslmode/ssl/sslrootcert gibi TLS
# parametreleri YAZMAYIN. pg sürücüsü URL'yi açık ssl ayarının üzerine yazar;
# ör. ?sslmode=disable, doğrulama açık sanılırken TLS'i sessizce kapatır.
# Bu parametreler başlangıçta REDDEDİLİR (fail-closed). TLS kararını yalnızca
# aşağıdaki POSTGRES_SSL_MODE ve POSTGRES_SSL_CA_FILE ile verin.
POSTGRES_SSL_MODE=
POSTGRES_MAX_CONNECTIONS=5

# Supabase REST/SDK yolu (DATABASE_DRIVER=supabase iken zorunlu).
# Bu anahtarlar YALNIZCA sunucu tarafında kullanılır; tarayıcı paketine girmez.
# Tablolar <prefix>_<koleksiyon> adıyla ve GIN indeksleriyle oluşturulur
# (npm run db:indexes).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Eski kurulumlar: MongoDB (DATABASE_DRIVER=mongo). Yeni Kurulumlar için önerilmez.
MONGODB_URI=
MONGODB_DB=kamuilan
# Boş bırakılırsa kalıcı yerleşik kuyruk (veritabanı) kullanılır (bullmq için doldurulur).
REDIS_URL=

# --- Zamanlayıcı / worker ---
SCHEDULER_ENABLED=1
SCHEDULER_TICK_MS=30000
WORKER_NAMESPACE=kamuilan
WORKER_CONCURRENCY=2
# Öneri: 0 = her kaynak kendi aralığıyla taranır (src/config/sources.ts, 60–120 dk).
# Pozitif değer TÜM kaynaklara aynı aralığı uygular; 15 dakikanın altı 15'e yükseltilir
# (1 değeri 24 resmî siteye dakikada bir istek gönderir ve kaynakların ulaşılamaz olmasına yol açar).
SCAN_INTERVAL_MINUTES=0

# --- Tarama (kaynaklar) ---
# Tek kaynak taramasının TOPLAM zaman bütçesi (5000–300000 ms). Resmî siteler ve
# PDF ağırlıklı kaynaklar (Resmî Gazete) yavaştır: 60000 değeri koşumu ortasında
# kesip okunan satırları çöpe atıyordu. Bütçe bitmeye yaklaşınca adaptör yeni
# detay indirmeyi bırakır ve elindeki satırları "kısmi" kapsamla kaydeder.
SCRAPE_TIMEOUT_MS=120000
SCRAPE_MAX_RETRIES=3
SCRAPE_USER_AGENT=KamuİlanBot/0.1 (+https://github.com/kaaradumaann-psi/kamuilan; kamu personel ilanı toplayıcı)
# Gerçek kaynaklara canlı istek atılsın mı? 0 = ağa çıkılmaz; tarama "atlandı" kaydedilir, başarı sayılmaz.
SOURCE_LIVE_FETCH=1
# HTTP istemcisi cevap alamazsa (ECONNRESET/zaman aşımı) sayfa başsız Chromium ile okunsun mu?
# 1 = evet (Resmî Gazete gibi tarayıcı-dışı istemciyi yavaşlatan siteler için gerekir;
# npx playwright install chromium kurulu olmalıdır). 0 = tarayıcı başlatılmaz, asıl hata bildirilir.
# Testlerde zorunlu 0'dır (tests/setup.ts): Chromium gerçek ağa çıktığı için sahte istemciyi yanıltır.
SOURCE_BROWSER_FALLBACK=1
# Sunucu ara sertifikayı göndermezse (UNABLE_TO_VERIFY_LEAF_SIGNATURE: ilan.gov.tr, BDDK, TMSF)
# eksik halka yapraktaki AIA adresinden indirilip DOĞRULANARAK zincire eklenir ve istek
# doğrulama AÇIKKEN yeniden denenir. 0 = tamamlama kapalı (doğrulama yine açıktır).
SOURCE_TLS_AIA_COMPLETION=1
# Kaynak başına en kısa istek aralığı (ms) — hız sınırlarına saygı için.
SOURCE_MIN_REQUEST_INTERVAL_MS=1500
# SSRF koruması: yalnızca bu alan adlarına istek atılır.
SOURCE_ALLOWED_HOSTS=resmigazete.gov.tr,www.resmigazete.gov.tr,ilan.gov.tr,www.ilan.gov.tr,medya.ilan.gov.tr,osym.gov.tr,www.osym.gov.tr,dokuman.osym.gov.tr,iskur.gov.tr,www.iskur.gov.tr,esube.iskur.gov.tr,kariyerkapisi.gov.tr,www.kariyerkapisi.gov.tr,personel.meb.gov.tr,kamuilan.sbb.gov.tr
# Belge indirme sınırları (bayt / yönlendirme / zaman aşımı)
MAX_DOCUMENT_BYTES=15728640
MAX_REDIRECTS=3
DOCUMENT_TIMEOUT_MS=20000

# --- E-posta ---
# resend (ÜRETİM) | smtp | file (geliştirme).
#
# ÖNTANIMLI OLARAK smtp: bu dosya olduğu gibi `.env` yapıldığında `npm run dev`
# ve `npm run env:check` ÇALIŞMALIDIR. `resend` seçilirse RESEND_API_KEY boşken
# uygulama bilinçli olarak BAŞLAMAZ (e-postanın sessizce kaybolmasını engellemek
# için); anahtarı girmeden resend'e geçmeyin.
EMAIL_PROVIDER=smtp

# Resend: https://resend.com → API Keys. Sunucu tarafında kalır.
# Doğrulanmış alan adından gönderim yapılır: EMAIL_FROM altındaki adres.
RESEND_API_KEY=
# Test/geliştirme için farklı bir uç nokta (varsayılan: https://api.resend.com).
RESEND_API_BASE_URL=https://api.resend.com

# SMTP (alternatif): RESEND_API_KEY boşsa ve SMTP_HOST doluysa kullanılır.
# Hiçbiri yoksa geliştirmede dosya taşıyıcısı kullanılır ve GERÇEK e-posta
# gönderilmez (data/mail/*.html|.txt). Üretimde bir sağlayıcı ZORUNLUDUR.
#
# Geliştirmede 127.0.0.1: `npm run dev` ile başlayan yerel posta sunucusudur
# (görüntüleyici: http://localhost:1080). Böylece davet/doğrulama/bildirim
# e-postaları gerçekten SMTP hattından geçer ve gelen kutuda görünür.
# Gerçek bir sağlayıcı kullanıyorsanız buraya onun adresini yazın (genelde 587 + STARTTLS).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP sertifika doğrulamasını kapatır (0 = doğrulama AÇIK, önerilen). Yalnızca
# kendinden imzalı sunucuda ve kök dosyası eklenemiyorsa 1 yapın; doğru çözüm
# NODE_EXTRA_CA_CERTS=./certs/kurum-koku.pem ile kökü tamamlamaktır.
SMTP_TLS_INSECURE=0
EMAIL_FROM=Kamuİlan <bildirim@example.com>
# Doğrulama/abonelik jetonlarının imzası; boşsa APP_SECRET kullanılır.
EMAIL_VERIFICATION_SECRET=
# Geliştirme dosya taşıyıcısı: 1 → e-postalar diske yazılır (test taşıyıcı).
EMAIL_DEV_FILE_TRANSPORT=1
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=60000
# Geliştirme posta görüntüleyicisi (scripts/dev-smtp-server.ts): http://localhost:1080
DEV_MAIL_VIEWER_PORT=1080

# --- Telegram bildirimleri (isteğe bağlı) ---
# Boş bırakılırsa Telegram kanalı tamamen kapalıdır; e-posta bildirimleri etkilenmez.
# Bot: @BotFather → /newbot ile oluşturun. Token sunucuda kalır, istemciye gitmez.
TELEGRAM_BOT_TOKEN=
# Bot kullanıcı adı (@ olmadan, "bot" ile biter). Bağlantı bağlantılarını üretmek için gerekir.
TELEGRAM_BOT_USERNAME=
# Webhook sırrı (1–256 karakter: A-Z a-z 0-9 _ -). Telegram her istekte bu değeri başlıkta gönderir.
# Token tanımlıyken üretimde ZORUNLUDUR; boşsa webhook 404 döner ve bağlantı kurulamaz.
# Üretmek için: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Bot API taban adresi. Üretimde değiştirmeyin.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Yapay zekâ destekli öneriler (isteğe bağlı, varsayılan KAPALI) ---
# Kullanıcılar panelde açıkça rıza verdiğinde, profillerini ve açık ilanları karşılaştırıp
# başvurmaya değer ilanları önerir. Rıza olmadan hiçbir veri gönderilmez.
# 1 yapmadan önce KVKK metnini ve sağlayıcının veri işleme koşullarını gözden geçirin.
AI_ASSISTANT_ENABLED=0
# Kullanıcının rıza ekranında gördüğü sağlayıcı adı (ör. "Groq", "Kendi sunucumuz").
AI_PROVIDER_LABEL=harici bir yapay zekâ hizmeti
# Sağlayıcı kökü. Kök adres yazılır; istemci ucu kendisi kurar. Üretimde https:// olmalı.
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta
#                  → istemci Google'ın BİRİNCİL API'sini kullanır:
#                    POST {kök}/models/{model}:generateContent  (x-goog-api-key başlığı)
#                  Model kimliği "gemini-2.5-flash" biçiminde yazılır (models/ öneki gerekmez).
#                  Not: Google'ın /v1beta/openai/chat/completions uyumluluk kabuğu her
#                  anahtar/bölge/model için çalışmıyor (404); bu yüzden kullanılmıyor.
#   OpenAI       : https://api.openai.com/v1            (model: gpt-4o-mini …)
#   OpenRouter   : https://openrouter.ai/api/v1         (model: google/gemini-2.5-flash …)
#   Groq         : https://api.groq.com/openai/v1       (model: llama-3.3-70b-versatile …)
#   Ollama       : http://127.0.0.1:11434/v1            (yerel model adı)
# Google dışındaki köklere istemci /chat/completions ekler (OpenAI uyumlu biçim).
# Tanı: npm run llm:doctor  (karşılaştırma: npm run llm:doctor -- --compat)
LLM_BASE_URL=
# Sağlayıcı API anahtarı. Yalnızca sunucuda; loglarda ve hata metinlerinde maskelenir.
LLM_API_KEY=
# Kullanılacak model adı (ör. llama-3.1-8b-instant).
LLM_MODEL=
# Model çağrısı zaman aşımı (ms, 5.000–120.000). Aşılırsa yedek (profil eşleştirmesi) gösterilir.
LLM_TIMEOUT_MS=30000
# Kullanıcı başına günlük model çağrısı sınırı (1–100). Önbellek isabetleri kotadan düşmez.
AI_DAILY_LIMIT_PER_USER=5

# --- LLM sınıflandırma kapısı (ingest hattı; varsayılan KAPALI) ---
# Kuralların "inceleme" (belirsiz) dediği duyurularda ikinci aşama LLM denetimi.
# Model kanıtı kaynak metinde birebir doğrulanmadan hiçbir karar uygulanmaz;
# sağlayıcı hatasında kayıt inceleme kuyruğunda kalır (asla otomatik onay yok).
# Gereksinimler: LLM_BASE_URL + LLM_API_KEY + LLM_CLASSIFIER_MODEL (veya LLM_MODEL).
# Önerilen kurulum ve sağlayıcı karşılaştırması: docs/llm-karari.md
LLM_CLASSIFIER_ENABLED=0
# İstem sürümüyle birlikte önbellek anahtarını belirleyen model (ör. llama-3.3-70b-versatile).
# Boş bırakılırsa LLM_MODEL kullanılır (panel önerisiyle aynı model).
LLM_CLASSIFIER_MODEL=
# Sağlayıcıya gönderilecek azami ilan metni (karakter, 1.000–40.000). E-posta/telefon/T.C. no maskelenir.
LLM_MAX_INPUT_CHARS=12000
# Tek kaynak taramasında azami LLM çağrısı (0–500). Maliyet freni; aşan kayıtlar incelemede kalır.
LLM_MAX_CALLS_PER_RUN=12
# Tüm worker'larda günlük toplam çağrı sınırı (1–100.000).
LLM_DAILY_CALL_LIMIT=400
# Aynı anda sürebilecek istek sayısı (1–8).
LLM_MAX_CONCURRENCY=2
# Geçici hatalarda (429/5xx/zaman aşımı) ek deneme (0–3).
LLM_RETRY_MAX=1
# Sağlayıcı fiyatı (USD / milyon token). BOŞ bırakılırsa maliyet RAPORLANMAZ
# (rakam uydurulmaz). Yalnızca sağlayıcının resmî fiyat sayfasından doğruladığınız
# değerleri yazın; girilen değerle üretilen satır her raporda TAHMİN olarak etiketlenir.
LLM_COST_USD_PER_MTOK_INPUT=
LLM_COST_USD_PER_MTOK_OUTPUT=
# İki fiyat varsayımı ve aşağıdaki iki limit birlikte olmadan production'da LLM açılamaz.
# Rezervasyon üst sınırlarıdır; doğrulanmış provider faturası değildir.
LLM_RUN_COST_LIMIT_USD=
LLM_DAILY_COST_LIMIT_USD=

# --- Kayıt politikası ---
# Kamuİlan'da dışarıdan kendi kendine kayıt YOKTUR: hesaplar yönetici davetiyle
# açılır (POST /api/admin/users → tek kullanımlık şifre belirleme bağlantısı).
# Yalnızca geçici test/geliştirme için 1 yapılabilir; üretimde 0 kalmalıdır.
ALLOW_PUBLIC_REGISTRATION=0

# --- Güvenlik ---
SESSION_TTL_HOURS=336
CSRF_ENABLED=1
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# X-Forwarded-For başlığına güvenilsin mi? VARSAYILAN 0 (kapalı).
# Yalnızca uygulamanın ÖNÜNDE, başlığı kendisi ÜRETEN bir vekil (Cloudflare,
# Nginx) varsa 1 yapın. Aksi hâlde istemci uydurma IP ile hız sınırını atlar
# ve denetim kaydına yanlış IP yazılır.
TRUST_PROXY=0
# Tarayıcı arayüzü API ile aynı kaynaktan konuşur; üretimde CORS kapalıdır.
# Yalnızca ayrı bir panel alan adından erişim gerekiyorsa virgülle listelenir.
CORS_ORIGINS=
# OpenAPI arayüzü (/api/docs). Geliştirmede açık, üretimde varsayılan KAPALIDIR.
DOCS_ENABLED=0

# --- İlk yönetici (yalnızca `npm run seed:admin` kullanır; repoda tutulmaz) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
