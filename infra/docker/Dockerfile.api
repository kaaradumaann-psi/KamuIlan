# KamuRadar — API ve worker imajı (Node 22)
#
# Bu imaj hem API hem worker hem de (compose içinde) Vite dev sunucusu için
# kullanılır. Üretimde aynı imaj `npx tsx src/server/main.ts` / `src/worker/main.ts`
# komutlarıyla çalışır; TypeScript doğrudan tsx ile yürütülür (ayrı derleme adımı yok,
# `npm run build` yalnızca arayüzü derler).
FROM node:22-alpine

WORKDIR /app

# Bağımlılıklar önce kopyalanır: katman önbelleği korunur.
COPY package.json package-lock.json ./
# Playwright tarayıcıları imaja dahil edilmez; Kariyer Kapısı adaptörü ayrıca
# belgelenmiştir (docs/sources.md). Kurmak isterseniz: `npx playwright install chromium`.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --include=dev --no-audit --no-fund

COPY tsconfig.json vite.config.ts vitest.config.ts index.html ./
COPY src ./src
COPY scripts ./scripts
COPY public ./public
COPY fixtures ./fixtures
COPY tests ./tests

ENV NODE_ENV=production
# Uygulama çalışma anında ortam değişkenlerini doğrular (src/config/env.ts).
EXPOSE 3000

CMD ["npx", "tsx", "src/server/main.ts"]
