# KamuRadar — üretim arayüz imajı (statik derleme + nginx)
#
# Derleme: `npm run build` (Vite) → dist/
# Sunum:   nginx, SPA yönlendirmeleri ve /api proxy'si ile.
#
# API_ORIGIN build arg'ı derleme sırasında KULLANILMAZ; proxy hedefi çalışma
# anında ORIGIN_API ortam değişkeniyle verilir (infra/docker/nginx.conf).
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY public ./public
RUN npm run build

FROM nginx:1.27-alpine

COPY infra/docker/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

# API adresi (compose/k8s içinde servis adı). Öntanımlı: yerel API.
ENV API_ORIGIN=http://api:3000

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
